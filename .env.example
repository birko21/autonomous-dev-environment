# Copy values into your shell or approved secret manager. Never commit .env files.

# Runtime mode: mock | live
ADE_MODE=mock

# OpenAI Responses API (live OpenAI/Codex provider)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Jules REST API
JULES_API_KEY=
JULES_SOURCE=
JULES_STARTING_BRANCH=main
JULES_BASE_URL=https://jules.googleapis.com/v1alpha

# TypeSafe AI Jev System One API.
# TYPESAFE_BASE_URL is intentionally explicit so the operator can pin the documented endpoint in use.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=
TYPESAFE_MODEL=jev-latest

# GitHub adapter
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_API_URL=https://api.github.com

# Provider routing overrides (defaults depend on ADE_MODE)
ADE_DECISION_PROVIDER=
ADE_PRIMARY_WORKER=
ADE_LOW_COST_WORKER=
ADE_REVIEW_WORKER=

# Local runtime
ADE_DATA_DIR=.ade
ADE_WORKSPACE=.
ADE_MAX_RETRIES=2
ADE_MAX_ACTION_STEPS=8
ADE_PROVIDER_TIMEOUT_MS=120000
ADE_VERIFICATION_TIMEOUT_MS=180000
ADE_EVIDENCE_RETENTION_DAYS=30
ADE_LOCK_STALE_MS=300000
ADE_POLICY_FILE=
# Set only when the deployment has an external sandbox and state directory.
ADE_REQUIRE_ISOLATION=false
